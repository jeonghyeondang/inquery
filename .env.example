# ============================================
# Inquery Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- PostgreSQL ---
POSTGRES_DB=inquery
POSTGRES_USER=inquery
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Backend (Spring Boot) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=inquery
DB_USERNAME=inquery
DB_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-a-random-secret-key
CORS_ALLOWED_ORIGINS=*

# --- Exposed Port ---
# The port you access Inquery on (http://localhost:80)
APP_PORT=80
