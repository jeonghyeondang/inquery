{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inquery",
  "version": "0.1.0",
  "identifier": "ai.inquery.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI_ENV=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Inquery",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/inquery-server"
    ],
    "resources": [
      "resources/**/*"
    ]
  }
}
