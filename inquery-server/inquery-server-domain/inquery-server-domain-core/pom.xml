        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-server-tools-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ehcache</groupId>
            <artifactId>ehcache</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.cache</groupId>
            <artifactId>cache-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-mysql</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-clickhouse</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-db2</artifactId>
            <version>${revision}</version>
        </dependency>


        
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-hive</artifactId>
            <version>${revision}</version>
        </dependency>
        
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-mariadb</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-mongodb</artifactId>
            <version>${revision}</version>
        </dependency>
        


        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-oracle</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-postgresql</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
            <artifactId>inquery-presto</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>ai.inquery</groupId>
