<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <!-- Introduce spring startup project -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>ai.inquery</groupId>
    <artifactId>inquery-server-parent</artifactId>
    <packaging>pom</packaging>
    <version>${revision}</version>
    <name>inquery-server-parent</name>

    <url>https://github.com/jeonghyeondang/inquery</url>
    <scm>
        <url>https://github.com/jeonghyeondang/inquery</url>
        <connection>scm:git:git://github.com/jeonghyeondang/inquery.git</connection>
        <developerConnection>scm:git:ssh://github.com/jeonghyeondang/inquery.git</developerConnection>
    </scm>

    <properties>
        <!-- The version of the current project uses flatten and only needs to modify this one place -->
        <revision>2.0.0-SNAPSHOT</revision>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.source>17</maven.compiler.source>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- keep tests enabled by default -->
        <maven.test.skip>false</maven.test.skip>
        <!-- Override commons-lang3 for embedded-postgres + commons-compress compatibility -->
        <commons-lang3.version>3.17.0</commons-lang3.version>
    </properties>

    <modules>
        <module>inquery-server-domain</module>
        <module>inquery-server-tools</module>
        <module>inquery-server-web</module>
        <module>inquery-spi</module>
        <module>inquery-plugins</module>
        <module>inquery-server-web-start</module>
    </modules>

